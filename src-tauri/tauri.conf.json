{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ParsecPlus",
  "version": "0.1.0",
  "identifier": "com.parsecplus.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ParsecPlus",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 660,
        "center": true,
        "resizable": true,
        "decorations": false,
        "fullscreen": false,
        "backgroundColor": "#08090c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Low-latency remote desktop",
    "longDescription": "ParsecPlus is a clean-room remote desktop client and host built for fast, private access to every computer you own.",
    "copyright": "ParsecPlus contributors",
    "macOS": {
      "minimumSystemVersion": "12.3",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
